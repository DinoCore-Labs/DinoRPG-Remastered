{
	"name": "dinorpg",
	"version": "0.15.0",
	"description": "Re-développement du jeu DinoRPG de Motion Twin",
	"private": true,
	"author": "DinoRPG Remastered Contributors",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/DinoCore-Labs/DinoRPG-Remastered.git"
	},
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"client:dev": "pnpm --filter @dinorpg/client run dev",
		"server:dev": "pnpm --filter @dinorpg/server run dev",
		"db:sync": "pnpm --filter @dinorpg/server db:sync:dev",
		"core:dev": "pnpm --filter @dinorpg/core run dev",
		"dev": "pnpm --recursive --parallel --stream run dev",
		"check": "pnpm eslint . --ext .ts,.tsx,.vue && prettier --check \"**/*.{ts,tsx,js,vue,css,json,md}\"",
		"fix": "pnpm eslint . --ext .ts,.tsx,.vue --fix && prettier --write \"{app,packages}/**/*.{ts,tsx,js,jsx,vue,json,md,yml,yaml,css,scss}\"",
		"build": "pnpm --recursive run build",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"prepare": "husky",
		"build-changelog": "node scripts/generate-root-changelog.js",
		"test:prepare": "pnpm --filter @dinorpg/core build",
		"test:unit": "pnpm test:prepare && pnpm --filter @dinorpg/core test:unit && pnpm --filter @dinorpg/server test:unit && pnpm --filter @dinorpg/client test:unit",
		"test:coverage": "pnpm test:prepare && pnpm --filter @dinorpg/core test:coverage && pnpm --filter @dinorpg/server test:coverage && pnpm --filter @dinorpg/client test:coverage",
		"test:integration": "pnpm test:prepare && pnpm --filter @dinorpg/server test:integration",
		"test:integration:ci": "pnpm test:prepare && pnpm --filter @dinorpg/server test:integration:ci",
		"test": "pnpm test:unit && pnpm test:integration",
		"test:e2e": "pnpm test:prepare && playwright test",
		"test:e2e:ui": "pnpm test:prepare && playwright test --ui",
		"test:e2e:debug": "pnpm test:prepare && playwright test --debug",
		"test:all": "pnpm test && pnpm test:e2e"
	},
	"lint-staged": {
		"*.{ts,tsx,vue,js,json,css,md}": [
			"pnpm eslint --fix",
			"pnpm prettier --write"
		]
	},
	"keywords": [],
	"packageManager": "pnpm@10.12.1",
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@playwright/test": "^1.63.0",
		"@types/node": "^25.6.0",
		"@typescript-eslint/eslint-plugin": "^8.69.0",
		"@typescript-eslint/parser": "^8.69.0",
		"dotenv": "^17.4.2",
		"eslint": "^10.9.1",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-vue": "^10.9.0",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.4.1",
		"prettier": "^3.9.6",
		"tsc-watch": "^7.2.1",
		"typescript": "~6.0.3",
		"vue-eslint-parser": "^10.4.1"
	},
	"dependencies": {
		"@prisma/client-runtime-utils": "7.10.0"
	}
}
